# Copy to .env. Everything here is optional: `npm run dev` works with no .env at all.

# A GitHub token lifts the 60-request-per-hour cap on unauthenticated API calls, which the download
# page and the changelogs generator both use. It needs no scopes; a bare classic token or a
# fine-grained one with public read access is enough.
GITHUB_TOKEN=

# Where the app repo is, if it is not the sibling directory `../app`.
# REIKAI_APP_REPO=

# The ref that links into the app repo point at. Defaults to whatever branch the app repo is
# currently on, so during a release cycle you do not have to set this.
# REIKAI_DOCS_REF=main
